{
  "name": "sis2-playwright",
  "version": "2.0.0",
  "private": true,
  "description": "E2E tests for Practice Software Testing Toolshop with Playwright Test and a GitHub Actions pipeline",
  "scripts": {
    "test": "playwright test",
    "test:ci": "cross-env CI=true playwright test",
